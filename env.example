# LightRAG / RagEngine environment template.
#
# First-time setup: run
#   uv run python scripts/bootstrap_deployment.py
# The script copies this file to .env, generates TOKEN_SECRET, and
# creates the platform auth DB. You still need to fill in your LLM /
# embedding provider API keys below before starting the server.
#
# The default provider shown below is Alibaba DashScope (compatible
# mode) + Qwen3.6-plus + text-embedding-v4 — the stack this deployment
# has been validated against end-to-end. Swap to OpenAI / Azure / Ollama
# / Gemini / Bedrock / local vLLM via the provider-specific blocks in
# docs/Configuration.md.
#
# Every advanced knob (tuning, storage backends, observability, eval)
# also lives in docs/Configuration.md — keep this template lean.

############################
### Server
############################
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='My Graph KB'
WEBUI_DESCRIPTION='Simple and Fast Graph Based RAG System'

############################
### Auth
############################
# JWT signing key. The bootstrap script writes a random 48-byte value
# here. If you skip the script, generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET=REPLACE_ME_WITH_RANDOM_48_BYTE_TOKEN

# When true, the login page exposes a 注册 tab and each registration
# auto-creates a personal workspace owned by the new user. Set false
# if every account must be admin-invited.
LIGHTRAG_ALLOW_SELF_REGISTRATION=true

# Optional API key for server-to-server calls. Clients send it in the
# X-API-Key header. Leave unset to require JWT login for everything.
# LIGHTRAG_API_KEY=

############################
### LLM — text chat completions
############################
# Provider: Alibaba DashScope compatible mode (OpenAI-compatible API).
# Replace LLM_BINDING_API_KEY with your own DashScope key.
LLM_BINDING=openai
LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BINDING_API_KEY=sk-REPLACE_ME_WITH_YOUR_DASHSCOPE_KEY
LLM_MODEL=qwen3.6-plus
LLM_TIMEOUT=300

# qwen3.6-plus is a reasoning model. Turn thinking OFF for indexing
# (entity extraction / summarization / keyword extraction) so each call
# does not burn ~1000 reasoning tokens, and turn it ON for user-facing
# query answering where the extra quality pays off.
OPENAI_LLM_EXTRA_BODY='{"enable_thinking": false}'
QUERY_ENABLE_THINKING=true

############################
### Embedding — text
############################
# Provider: Alibaba DashScope compatible mode, text-embedding-v4.
# DashScope caps at 10 rows per request and requires EMBEDDING_SEND_DIM
# so the server returns 2048-d vectors (default is 1024).
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BINDING_API_KEY=sk-REPLACE_ME_WITH_YOUR_DASHSCOPE_KEY
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=2048
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=true
EMBEDDING_BATCH_NUM=10

############################
### Vision LLM — image captioning (optional)
############################
# Consumed by the multimodal pipeline helpers (scripts, vision_model_func).
# Leave blank if you do not ingest images.
VISION_MODEL=qwen3-vl-plus
VISION_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_BINDING_API_KEY=sk-REPLACE_ME_WITH_YOUR_DASHSCOPE_KEY

############################
### Multimodal embedding — image + text → shared space (optional)
############################
# IMPORTANT: DashScope compatible mode does NOT support multimodal
# embeddings. The native dashscope SDK is the only supported path;
# LightRAG auto-installs it on first import of lightrag.llm.tongyi.
# Only set MM_EMB_BINDING_HOST if you route through a private gateway.
MM_EMB_MODEL=tongyi-embedding-vision-plus-2026-03-06
MM_EMB_DIM=1152
MM_EMB_BINDING_API_KEY=sk-REPLACE_ME_WITH_YOUR_DASHSCOPE_KEY
# MM_EMB_BINDING_HOST=

############################
### Concurrency (tuned for DashScope qwen3.6-plus: up to 50 concurrent)
############################
MAX_ASYNC=16                     # concurrent LLM requests
MAX_PARALLEL_INSERT=2            # parallel documents (2–10)
EMBEDDING_FUNC_MAX_ASYNC=16      # parallel embedding calls

############################
### Document processing
############################
# Cache LLM responses during entity/relation extraction.
ENABLE_LLM_CACHE_FOR_EXTRACT=true
# Output language for graph summaries / entity descriptions.
SUMMARY_LANGUAGE=Chinese
# Only summarize the most-cited entities — large PDFs with 20-30
# mentions per key term otherwise make the merge phase drag. 20 is
# a reasonable balance; default upstream is 8.
FORCE_LLM_SUMMARY_ON_MERGE=20

############################
### Reranker (optional but recommended — see docs/Configuration.md)
############################
RERANK_BINDING=null

############################
### Storage (defaults are fine for local dev)
############################
# File-based — zero setup. Swap to Postgres / Neo4j / Redis / Milvus /
# Qdrant / MongoDB for production. See docs/Configuration.md.
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
